[Unit]
Description=Sahaayaka GitHub CI aggregate check
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
ExecStart=/opt/sahaayaka/sahaayaka
DynamicUser=yes
User=sahaayaka
StateDirectory=sahaayaka
StateDirectoryMode=0700
WorkingDirectory=/var/lib/sahaayaka
UMask=0077

Environment=NODE_ENV=production
Environment=LOG_LEVEL=info
Environment=DATABASE_PATH=/var/lib/sahaayaka/sahaayaka.sqlite
Environment=PRIVATE_KEY_PATH=%d/private-key.pem
Environment=WEBHOOK_SECRET_FILE=%d/webhook-secret
EnvironmentFile=/etc/sahaayaka/sahaayaka.env
LoadCredential=private-key.pem:/etc/sahaayaka/private-key.pem
LoadCredential=webhook-secret:/etc/sahaayaka/webhook-secret

Restart=on-failure
RestartSec=5s
TimeoutStopSec=40s

[Install]
WantedBy=multi-user.target
